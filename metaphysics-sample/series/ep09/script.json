{
  "title": "白话《形而上学》",
  "subtitle": "第9集 · 卷九 Θ · 潜能与现实",
  "scenes": [
    {
      "id": "s1", "name": "能成为与真成为",
      "phrases": [
        { "el": "cards",  "text": "第九卷，专讲两个词：潜能和现实。" },
        { "el": "seed",   "text": "一颗种子，有长成大树的潜能；" },
        { "el": "tree",   "text": "真长成了，就是现实。" },
        { "el": "kid",    "text": "一个孩子，有成为大人的潜能；" },
        { "el": "wood",   "text": "一块木头，有成为雕像的潜能。" }
      ]
    },
    {
      "id": "s2", "name": "麦加拉派",
      "phrases": [
        { "el": "megara",    "text": "有一派人，叫麦加拉派，他们说：" },
        { "el": "building",  "text": "只有正在盖房子的时候，才算会盖房子；" },
        { "el": "resting",   "text": "一停下来，就不会了。" },
        { "el": "aristotle", "text": "亚里士多德说，这太荒唐了：" },
        { "el": "blink",     "text": "照这么说，人一闭上眼睛就算瞎了，岂不是一天要瞎好几次？" }
      ]
    },
    {
      "id": "s3", "name": "现实在先",
      "phrases": [
        { "el": "order",    "text": "而且，现实比潜能更在先。" },
        { "el": "master",   "text": "先有会盖房子的师傅，才教得出学徒；" },
        { "el": "chickegg", "text": "要问先有鸡还是先有蛋，亚里士多德会说：先有鸡。" },
        { "el": "goal",     "text": "潜能，是为了现实而存在的。" }
      ]
    },
    {
      "id": "s4", "name": "本身就是完成",
      "phrases": [
        { "el": "ring",      "text": "有些活动，本身就是目的：" },
        { "el": "seeing",    "text": "看，在看的那一刻，就已经看到了；" },
        { "el": "living",    "text": "活着、思考、幸福，也都是这样。" },
        { "el": "halfhouse", "text": "可盖房子不一样，没盖完，就还没完成。" }
      ]
    }
  ]
}
