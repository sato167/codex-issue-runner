{
  "title": "白话《形而上学》",
  "subtitle": "第3集 · 卷三 Β · 先解开绳结",
  "scenes": [
    {
      "id": "s1", "name": "难题像绳结",
      "phrases": [
        { "el": "cards",  "text": "第三卷，亚里士多德先不急着回答，而是把难题一个个摆上桌。" },
        { "el": "rope",   "text": "他说，难题就像绳结，" },
        { "el": "untie",  "text": "不先看清结在哪儿，就解不开它；" },
        { "el": "road",   "text": "又像赶路的人，不知道该往哪儿走，" },
        { "el": "finish", "text": "就算到了终点，也认不出来。" }
      ]
    },
    {
      "id": "s2", "name": "一口气列了十几个",
      "phrases": [
        { "el": "icons",    "text": "第一个难题：研究各种原因的，" },
        { "el": "umbrella", "text": "是一门学问，还是好几门？" },
        { "el": "logic",    "text": "第二个：研究实体的人，也要管推理的规矩吗？" },
        { "el": "pile",     "text": "像这样的难题，他一口气列了十几个。" }
      ]
    },
    {
      "id": "s3", "name": "有没有共同的东西",
      "phrases": [
        { "el": "cups",   "text": "比如：除了眼前一个个具体的杯子，" },
        { "el": "ghost",  "text": "还有没有一个看不见的“杯子本身”？" },
        { "el": "plato",  "text": "老师柏拉图说有，叫“理念”，在天上；" },
        { "el": "doubt",  "text": "学生亚里士多德，却很怀疑。" }
      ]
    },
    {
      "id": "s4", "name": "先摆上桌",
      "phrases": [
        { "el": "candle", "text": "还有：会熄灭的蜡烛和永恒的星星，本原一样吗？" },
        { "el": "one",    "text": "“一”和“存在”本身，是不是一种实体？" },
        { "el": "yarn",   "text": "这些问题听起来很绕，" },
        { "el": "table",  "text": "可只有先把它们摆上桌，" },
        { "el": "path",   "text": "后面的路，才走得清楚。" }
      ]
    }
  ]
}
