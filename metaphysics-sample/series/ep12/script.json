{
  "title": "白话《形而上学》",
  "subtitle": "第12集 · 卷十二 Λ · 不动的推动者",
  "scenes": [
    {
      "id": "s1", "name": "三种实体",
      "phrases": [
        { "el": "peak",    "text": "第十二卷，是整部书的高峰。" },
        { "el": "podium",  "text": "亚里士多德说，实体有三种：" },
        { "el": "flower",  "text": "一种会生会灭，比如花草和动物；" },
        { "el": "orbit",   "text": "一种永远在转，比如天上的星辰；" },
        { "el": "mover",   "text": "还有一种，自己不动，却推动着一切。" }
      ]
    },
    {
      "id": "s2", "name": "第一推动者",
      "phrases": [
        { "el": "gears",   "text": "万物都在运动，总得有一个最初的推动者；" },
        { "el": "regress", "text": "要是它自己也在动，就还得有谁来推它，" },
        { "el": "still",   "text": "所以，第一推动者，必须自己不动。" }
      ]
    },
    {
      "id": "s3", "name": "像被爱的对象",
      "phrases": [
        { "el": "q",          "text": "那它怎么推动别的东西呢？" },
        { "el": "hand",       "text": "不是用手去推，" },
        { "el": "lover",      "text": "而是像一个被爱、被向往的对象，" },
        { "el": "lighthouse", "text": "就像夜里的灯塔，船会自己朝它驶去。" }
      ]
    },
    {
      "id": "s4", "name": "思想的思想",
      "phrases": [
        { "el": "thinker", "text": "这个不动的推动者，在做什么呢？" },
        { "el": "loop",    "text": "它在思考，而且思考的是它自己，叫“思想的思想”。" },
        { "el": "god",     "text": "它永远处在最好的状态，亚里士多德称它为“神”。" },
        { "el": "crowns",  "text": "最后，他引用荷马的诗：多头统治不好，让一个来统治吧。" }
      ]
    }
  ]
}
