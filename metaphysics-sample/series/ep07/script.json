{
  "title": "白话《形而上学》",
  "subtitle": "第7集 · 卷七 Ζ · 什么是实体",
  "scenes": [
    {
      "id": "s1", "name": "这一个",
      "phrases": [
        { "el": "aristotle", "text": "第七卷，亚里士多德追问全书最核心的问题：什么是实体？" },
        { "el": "cat",       "text": "实体，就是能独立存在的“这一个”，比如这只猫；" },
        { "el": "attrs",     "text": "而它的颜色、大小、在哪儿，都得依附在它身上。" }
      ]
    },
    {
      "id": "s2", "name": "剥洋葱",
      "phrases": [
        { "el": "clay",   "text": "那么，实体是材料吗？" },
        { "el": "onion",  "text": "把一个东西的颜色、形状、大小，像剥洋葱一样一层层剥掉，" },
        { "el": "blob",   "text": "最后只剩一团说不出是什么的东西，" },
        { "el": "nope",   "text": "它不可能是最根本的实体。" }
      ]
    },
    {
      "id": "s3", "name": "形式",
      "phrases": [
        { "el": "house",  "text": "实体更像是一个东西的“本质”，" },
        { "el": "form",   "text": "也就是让它成为它的那个“形式”。" },
        { "el": "ball",   "text": "一个铜球，就是铜加上球形；" },
        { "el": "smith",  "text": "铜匠做铜球，并没有“造出”球形，" },
        { "el": "into",   "text": "他只是把球形，放进了铜里。" }
      ]
    },
    {
      "id": "s4", "name": "共相不是实体",
      "phrases": [
        { "el": "people",   "text": "那“人”“动物”这种共同的名称，是实体吗？" },
        { "el": "stop",     "text": "亚里士多德说：不是。" },
        { "el": "socrates", "text": "实体，是苏格拉底，是这一个人；" },
        { "el": "many",     "text": "“人”，只是许多人共有的说法。" }
      ]
    }
  ]
}
