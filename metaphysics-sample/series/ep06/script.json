{
  "title": "白话《形而上学》",
  "subtitle": "第6集 · 卷六 Ε · 三门理论学问",
  "scenes": [
    {
      "id": "s1", "name": "为了做事，还是为了知道",
      "phrases": [
        { "el": "aristotle", "text": "第六卷，亚里士多德给学问分了分家。" },
        { "el": "ship",      "text": "有的学问是为了做事，比如造船、治病；" },
        { "el": "knower",    "text": "有的学问，只是为了知道。" }
      ]
    },
    {
      "id": "s2", "name": "三门理论学问",
      "phrases": [
        { "el": "pillars",  "text": "这种只为知道的学问，一共有三门：" },
        { "el": "physics",  "text": "物理学，研究会动、会变的东西；" },
        { "el": "math",     "text": "数学，研究不动的数和形，可它们离不开具体的事物；" },
        { "el": "theology", "text": "第一哲学，研究既不动、又独立存在的东西，他也叫它“神学”。" }
      ]
    },
    {
      "id": "s3", "name": "偶然",
      "phrases": [
        { "el": "dice",      "text": "接着，他讲了一种特别的“存在”：偶然。" },
        { "el": "digger",    "text": "有人在院子里挖坑种树，" },
        { "el": "treasure",  "text": "却挖到了一箱宝藏。" },
        { "el": "lucky",     "text": "挖宝藏不是种树的目的，只是碰巧。" },
        { "el": "builder",   "text": "又比如，一位建筑师碰巧也会弹琴，" },
        { "el": "blueprint", "text": "可盖房子的学问里，不会教你弹琴。" }
      ]
    },
    {
      "id": "s4", "name": "真正要研究的",
      "phrases": [
        { "el": "random",  "text": "偶然的事没有规律，" },
        { "el": "nobook",  "text": "所以也没有哪门学问专门研究它。" },
        { "el": "truth",   "text": "还有一种“存在”，是“真”：" },
        { "el": "judge",   "text": "说对了就是真，说错了就是假，它在我们的判断里，不在事物身上。" },
        { "el": "star",    "text": "所以，第一哲学要找的，是那个不变的、真正的存在。" }
      ]
    }
  ]
}
