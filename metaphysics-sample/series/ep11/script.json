{
  "title": "白话《形而上学》",
  "subtitle": "第11集 · 卷十一 Κ · 复习课",
  "scenes": [
    {
      "id": "s1",
      "name": "复习一遍",
      "phrases": [
        {
          "el": "notebook",
          "text": "第十一卷，像一堂复习课。"
        },
        {
          "el": "chain",
          "text": "它把前面讲过的要点，再串一遍："
        },
        {
          "el": "checks",
          "text": "求知、真理、难题、不矛盾律、哲学词典、偶然……"
        }
      ]
    },
    {
      "id": "s2",
      "name": "运动",
      "phrases": [
        {
          "el": "runner",
          "text": "然后，它讲到了运动。"
        },
        {
          "el": "growing",
          "text": "运动，就是潜能“正在”变成现实的过程："
        },
        {
          "el": "wall",
          "text": "砖头正在被砌成墙，"
        },
        {
          "el": "progress",
          "text": "这个“正在”，就是运动。"
        }
      ]
    },
    {
      "id": "s4",
      "name": "从一头到另一头",
      "phrases": [
        {
          "el": "chaos",
          "text": "变化，也不是乱变的。"
        },
        {
          "el": "ends",
          "text": "它总是从一头，走向另一头："
        },
        {
          "el": "changes",
          "text": "冷的变热，白的变黑，小树长成大树；"
        },
        {
          "el": "rocksong",
          "text": "一块石头，可不会忽然变成一首歌。"
        }
      ]
    },
    {
      "id": "s3",
      "name": "有没有无限",
      "phrases": [
        {
          "el": "infinity",
          "text": "那么，有没有无限大的东西？"
        },
        {
          "el": "aristotle",
          "text": "亚里士多德说：现实里没有。"
        },
        {
          "el": "numbers",
          "text": "数，可以一直往下数；"
        },
        {
          "el": "halving",
          "text": "一条线，可以一直往下分；"
        },
        {
          "el": "road",
          "text": "但这只是“潜在的”无限，永远也不会真的完成。"
        }
      ]
    }
  ]
}