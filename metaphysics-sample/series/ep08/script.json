{
  "title": "白话《形而上学》",
  "subtitle": "第8集 · 卷八 Η · 质料与形式",
  "scenes": [
    {
      "id": "s1", "name": "定义看差别",
      "phrases": [
        { "el": "equation",  "text": "第八卷接着说：一个实体，是质料和形式的结合。" },
        { "el": "diff",      "text": "怎么给东西下定义？要看它和别的东西，差在哪儿。" },
        { "el": "threshold", "text": "一根木头是门槛，是因为它放的位置；" },
        { "el": "ice",       "text": "冰是冰，是因为水凝固了；" },
        { "el": "shelter",   "text": "房子，是砖瓦木头，为了遮风挡雨，这样排列起来。" }
      ]
    },
    {
      "id": "s2", "name": "不用胶水",
      "phrases": [
        { "el": "puzzle",    "text": "那质料和形式，是两样东西拼在一起吗？" },
        { "el": "howone",    "text": "铜和圆形，怎么就变成了“一个”铜球？" },
        { "el": "aristotle", "text": "亚里士多德的回答是：" },
        { "el": "potential", "text": "铜，是“能成为”铜球的；" },
        { "el": "actual",    "text": "形式，让它“真的成为”铜球；" },
        { "el": "glue",      "text": "能成为的，变成了真成为的，本来就是一个，用不着胶水来粘。" }
      ]
    },
    {
      "id": "s3", "name": "身体与灵魂",
      "phrases": [
        { "el": "person", "text": "一个活生生的人也是这样：" },
        { "el": "soul",   "text": "身体是质料，灵魂是形式；" },
        { "el": "eye",    "text": "就像眼睛：眼珠是质料，“能看见”是它的形式；" },
        { "el": "stone",  "text": "石像上的眼睛，就只剩下“眼睛”这个名字了。" }
      ]
    }
  ]
}
