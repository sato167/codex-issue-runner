{
  "title": "白话《形而上学》",
  "subtitle": "第4集 · 卷四 Γ · 存在之为存在",
  "scenes": [
    {
      "id": "s1", "name": "研究一切存在的学问",
      "phrases": [
        { "el": "aristotle",  "text": "第四卷，亚里士多德宣布：" },
        { "el": "everything", "text": "有一门学问，不研究某一类东西，而是研究一切“存在”本身。" },
        { "el": "experts",    "text": "数学家研究数，医生研究身体，" },
        { "el": "whole",      "text": "他们都只切下一块；这门学问，要看整个。" }
      ]
    },
    {
      "id": "s2", "name": "健康的比喻",
      "phrases": [
        { "el": "word",      "text": "可“存在”这个词，有好多种说法。" },
        { "el": "heart",     "text": "就像“健康”：" },
        { "el": "three",     "text": "健康的食物，健康的气色，健康的运动，" },
        { "el": "arrows",    "text": "说法不同，却都指向同一个中心：身体的健康。" },
        { "el": "substance", "text": "“存在”也一样，颜色、大小、时间、地点，都围着一个中心转：实体。" }
      ]
    },
    {
      "id": "s3", "name": "最确定的原理",
      "phrases": [
        { "el": "foundation", "text": "这门学问，还要找出最确定的原理：" },
        { "el": "lamp",       "text": "同一样东西，不能在同一时间、同一方面，既是又不是。" },
        { "el": "doors",      "text": "比如，一扇门不能同时既开着，又关着。" },
        { "el": "tablet",     "text": "这就是“不矛盾律”，一切思考的地基。" }
      ]
    },
    {
      "id": "s4", "name": "否认它的人",
      "phrases": [
        { "el": "denier",  "text": "有人偏要否认它。" },
        { "el": "shh",     "text": "亚里士多德说：那你可以不说话了。" },
        { "el": "bubble",  "text": "因为只要你开口说出一个意思，" },
        { "el": "already", "text": "你就已经在用这条原理了。" },
        { "el": "well",    "text": "就连走路，他也会绕开水井，而不是直接掉进去。" }
      ]
    }
  ]
}
