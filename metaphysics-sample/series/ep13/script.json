{
  "title": "白话《形而上学》",
  "subtitle": "第13集 · 卷十三 Μ · 数学对象在哪里",
  "scenes": [
    {
      "id": "s1",
      "name": "数住在哪儿",
      "phrases": [
        {
          "el": "float",
          "text": "第十三卷，问了一个有趣的问题："
        },
        {
          "el": "three",
          "text": "数字三，圆形，三角形，"
        },
        {
          "el": "where",
          "text": "它们存在吗？存在在哪儿？"
        }
      ]
    },
    {
      "id": "s2",
      "name": "天上还是身边",
      "phrases": [
        {
          "el": "plato",
          "text": "柏拉图一派认为：它们住在另一个完美的世界里，"
        },
        {
          "el": "perfect",
          "text": "比我们看到的东西更真实。"
        },
        {
          "el": "aristotle",
          "text": "亚里士多德不同意："
        },
        {
          "el": "inthings",
          "text": "数和形，就在事物身上，"
        },
        {
          "el": "pull",
          "text": "是我们的头脑，把它们“抽”了出来。"
        }
      ]
    },
    {
      "id": "s4",
      "name": "多出来的世界",
      "phrases": [
        {
          "el": "socq",
          "text": "亚里士多德还说：苏格拉底只是想弄清“勇敢”“正义”到底是什么，"
        },
        {
          "el": "nosep",
          "text": "并没有把它们放到另一个世界去；"
        },
        {
          "el": "scissors",
          "text": "是后来的人，把它们和事物剪开了。"
        },
        {
          "el": "double",
          "text": "这就像一个人数东西，嫌太少数不清，偏要先翻一倍再数。"
        }
      ]
    },
    {
      "id": "s3",
      "name": "抽象",
      "phrases": [
        {
          "el": "wheel",
          "text": "就像看一个车轮，我们可以只看它的圆，"
        },
        {
          "el": "materials",
          "text": "不管它是木头做的，还是铁做的；"
        },
        {
          "el": "apples",
          "text": "看三个苹果，只想“三”，不管它们是不是苹果。"
        },
        {
          "el": "distill",
          "text": "所以数学，是从真实世界里提炼出来的学问。"
        }
      ]
    }
  ]
}