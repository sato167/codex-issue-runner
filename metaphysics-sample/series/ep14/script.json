{
  "title": "白话《形而上学》",
  "subtitle": "第14集 · 卷十四 Ν · 数不是万物的原因",
  "scenes": [
    {
      "id": "s1", "name": "最后的辩论",
      "phrases": [
        { "el": "debate",     "text": "最后一卷，亚里士多德继续和老同学们辩论。" },
        { "el": "pythagoras", "text": "毕达哥拉斯派说：万物都是数；" },
        { "el": "platonists", "text": "柏拉图派说：万物从“一”和“大与小”里生出来。" }
      ]
    },
    {
      "id": "s2", "name": "碰巧都是七",
      "phrases": [
        { "el": "seven",    "text": "亚里士多德问：一个数，凭什么让东西变好？" },
        { "el": "sevens",   "text": "七根琴弦、七颗星星、七岁换牙，" },
        { "el": "notcause", "text": "碰巧都是七，并不说明“七”就是它们的原因。" },
        { "el": "measure",  "text": "数是尺度，不是万物的本原。" }
      ]
    },
    {
      "id": "s3", "name": "一路走来",
      "phrases": [
        { "el": "path",   "text": "十四卷《形而上学》，我们一路走来：" },
        { "el": "start",  "text": "从“求知是人的天性”出发，" },
        { "el": "middle", "text": "追问原因、实体、潜能与现实，" },
        { "el": "end",    "text": "一直走到那个不动的推动者。" }
      ]
    },
    {
      "id": "s4", "name": "继续想下去",
      "phrases": [
        { "el": "night", "text": "两千多年过去了，这些问题，" },
        { "el": "kid",   "text": "仍然值得我们抬起头，好好想一想。" }
      ]
    }
  ]
}
