{
  "title": "白话《形而上学》",
  "subtitle": "第5集 · 卷五 Δ · 哲学小词典",
  "scenes": [
    {
      "id": "s1", "name": "一本小词典",
      "phrases": [
        { "el": "dict",     "text": "第五卷很特别，它是一本哲学小词典。" },
        { "el": "cards",    "text": "亚里士多德挑出三十来个关键词，" },
        { "el": "meanings", "text": "一个一个讲清楚：每个词，到底有几种用法。" }
      ]
    },
    {
      "id": "s2", "name": "原因有四种",
      "phrases": [
        { "el": "statue",   "text": "比如“原因”。一尊铜像，它的原因是什么？" },
        { "el": "material", "text": "第一，铜，这是它的材料；" },
        { "el": "form",     "text": "第二，它的样子，这是形式；" },
        { "el": "maker",    "text": "第三，雕刻家，是让它成形的推动者；" },
        { "el": "purpose",  "text": "第四，为了纪念英雄，这是目的。" }
      ]
    },
    {
      "id": "s3", "name": "自然与必然",
      "phrases": [
        { "el": "seed",      "text": "再比如“自然”：种子自己会长成大树，这是它的本性；" },
        { "el": "bed",       "text": "可把木床埋进土里，长出来的是树，不是床。" },
        { "el": "necessary", "text": "“必然”呢，就是不可能是别的样子：三角形的三个角，加起来一定等于两个直角。" }
      ]
    },
    {
      "id": "s4", "name": "说清楚再讨论",
      "phrases": [
        { "el": "stick",     "text": "“一”，可以是一根连着的木棍，" },
        { "el": "fish",      "text": "也可以是同一种类，比如所有的鱼；" },
        { "el": "being",     "text": "“存在”，有时说的是“是什么”，有时说的是“在哪儿”“有多大”；" },
        { "el": "alone",     "text": "“实体”，是不依附别的、自己独立存在的东西，比如这一个人。" },
        { "el": "chickduck", "text": "把词说清楚，后面的讨论，才不会鸡同鸭讲。" }
      ]
    }
  ]
}
