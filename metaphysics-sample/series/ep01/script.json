{
  "title": "白话《形而上学》",
  "subtitle": "第1集 · 卷一 Α · 求知是人的天性",
  "scenes": [
    {
      "id": "s1",
      "name": "雅典的大胡子",
      "phrases": [
        {
          "el": "temple",
          "text": "两千三百多年前，在古希腊的雅典，",
          "draws": "神庙"
        },
        {
          "el": "aristotle",
          "text": "住着一位大胡子老师，亚里士多德。",
          "draws": "大胡子亚里士多德挥手"
        },
        {
          "el": "scroll",
          "text": "有一天，他摊开一卷新书，",
          "draws": "书桌上展开的卷轴"
        },
        {
          "el": "quill",
          "text": "提笔写下第一句话：",
          "draws": "羽毛笔和墨迹"
        },
        {
          "el": "bulbs",
          "text": "所有人，天生都渴望知道。",
          "draws": "三个人头顶亮起灯泡"
        }
      ]
    },
    {
      "id": "s2",
      "name": "天生爱看",
      "phrases": [
        {
          "el": "eye",
          "text": "不信？你看。",
          "draws": "一只大眼睛睁开"
        },
        {
          "el": "baby",
          "text": "小婴儿刚睁开眼，就盯着彩色气球看个不停；",
          "draws": "婴儿盯着气球"
        },
        {
          "el": "sunrise",
          "text": "我们去旅行，不为赚钱，也要早起看一场日出。",
          "draws": "背包客看海上日出"
        },
        {
          "el": "hearts",
          "text": "看，本身就让人开心。",
          "draws": "到处冒出爱心"
        }
      ]
    },
    {
      "id": "s3",
      "name": "眼睛最会找不同",
      "phrases": [
        {
          "el": "lens",
          "text": "为什么偏偏是眼睛？",
          "draws": "放大镜里的眼睛"
        },
        {
          "el": "cards",
          "text": "因为它最会找不同：",
          "draws": "两张对比卡片和闪电"
        },
        {
          "el": "apples",
          "text": "红苹果，青苹果；",
          "draws": "红苹果与青苹果"
        },
        {
          "el": "moons",
          "text": "圆月亮，弯月亮；",
          "draws": "满月与弯月"
        },
        {
          "el": "cats",
          "text": "小花猫，大老虎，",
          "draws": "小猫与老虎"
        },
        {
          "el": "checks",
          "text": "一眼就分得清清楚楚。",
          "draws": "三个对勾"
        }
      ]
    },
    {
      "id": "s4",
      "name": "哲学始于惊奇",
      "phrases": [
        {
          "el": "memory",
          "text": "看多了、记住了，就成了经验。",
          "draws": "装满画面的记忆云"
        },
        {
          "el": "farmer",
          "text": "老农知道：燕子低飞，就要下雨。",
          "draws": "老农、低飞的燕子和雨云"
        },
        {
          "el": "ponder",
          "text": "可聪明的人还要追问：为什么？",
          "draws": "托腮思考的亚里士多德"
        },
        {
          "el": "stargazer",
          "text": "最早追问为什么的，是夜里仰望星空的人。",
          "draws": "山丘上看星星的人"
        },
        {
          "el": "wow",
          "text": "所以亚里士多德说：哲学，从惊奇开始。",
          "draws": "流星划过、惊叹迸发"
        }
      ]
    }
  ]
}