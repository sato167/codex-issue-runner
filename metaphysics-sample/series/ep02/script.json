{
  "title": "白话《形而上学》",
  "subtitle": "第2集 · 卷二 α · 真理难也不难",
  "scenes": [
    {
      "id": "s1", "name": "射不中的门",
      "phrases": [
        { "el": "mountain", "text": "第二卷一开头，亚里士多德说：探索真理，说难也难，说不难也不难。" },
        { "el": "archer",   "text": "说它不难，是因为没有人会完全错过它，" },
        { "el": "door",     "text": "就像对着一扇大门射箭，谁都射得中。" },
        { "el": "bullseye", "text": "说它难，是因为要射中门上的一个小点，" },
        { "el": "sweat",    "text": "那可就不容易了。" }
      ]
    },
    {
      "id": "s2", "name": "蝙蝠的眼睛",
      "phrases": [
        { "el": "mirror",   "text": "难处不在事情本身，而在我们自己。" },
        { "el": "bat",      "text": "就像蝙蝠的眼睛，" },
        { "el": "sun",      "text": "一到大白天，反而什么都看不清。" },
        { "el": "dazzle",   "text": "最明白的道理，我们的心灵也最容易看花眼。" },
        { "el": "bricks",   "text": "不过，每个前人都为真理添了一块砖；" },
        { "el": "glasses",  "text": "哪怕说错了的人，也帮我们练了眼力。" }
      ]
    },
    {
      "id": "s3", "name": "原因不能无穷倒退",
      "phrases": [
        { "el": "gear",     "text": "真正的知识，要找到原因。" },
        { "el": "dominoes", "text": "可原因背后还有原因，能一直追下去吗？" },
        { "el": "stop",     "text": "亚里士多德说：不能。" },
        { "el": "ladder",   "text": "要是原因无穷无尽，就没有第一个，" },
        { "el": "shrug",    "text": "那就什么也解释不了。" },
        { "el": "first",    "text": "所以，一定有一个最初的原因。" }
      ]
    },
    {
      "id": "s4", "name": "学习看习惯",
      "phrases": [
        { "el": "student",  "text": "最后他提醒：怎么学，要看你习惯什么。" },
        { "el": "ruler",    "text": "有人只信数学那样的精确，" },
        { "el": "lyre",     "text": "有人要举例子，有人要请诗人作证。" },
        { "el": "fuzzy",    "text": "可不是所有学问，都能像数学那样精确；" },
        { "el": "nature",   "text": "研究自然，就要用适合自然的方法。" }
      ]
    }
  ]
}
